# Needed only for Handoffs.
ANTHROPIC_API_KEY=
# LOOKOUT_AGENT_MODEL=claude-opus-5-5
# LOOKOUT_AGENT_EFFORT=high
# LOOKOUT_AGENT_MAX_TURNS=12

# Optional: let Handoffs read which MQTT topics Timebase Bridge publishes, so it never plans them.
# Create a Pulse client (client credentials) with read access to Bridge, and mount the Pulse root CA.
# Without these, Handoffs leaves out timebase/# on every broker.
# WITNESS_PULSE_CLIENT_ID=
# WITNESS_PULSE_CLIENT_SECRET=
# PULSE_URL=https://pulse:4542
# BRIDGE_URL=https://bridge:4572
# PULSE_CA_FILE=/run/lookout/pulse-ca.pem
